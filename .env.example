# Ombuds — required environment variables.
# NAMES ONLY. Never commit real values.
#
# Deployment-side vars are set on Convex, not in a local .env file:
#   npx convex env set OPENAI_API_KEY ...
#
# ---------------------------------------------------------------------------
# Convex deployment (written by `npx convex dev`, do not set by hand)
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# ---------------------------------------------------------------------------
# Set on the Convex deployment with `npx convex env set <NAME> <value>`
# ---------------------------------------------------------------------------

# AI. LLM_PROVIDER is `google` during the build and `openai` from Sep 15 on;
# the shipped submission runs on OpenAI. See CLAUDE.md section 11.
LLM_PROVIDER=
OPENAI_API_KEY=
# Dev-time provider only. Never reachable from a shipped code path (section 11).
GEMINI_API_KEY=

# Firecrawl — facility contact discovery, enrichment, news, licensing crawls.
FIRECRAWL_API_KEY=
FIRECRAWL_WEBHOOK_SECRET=

# AgentMail — one inbox per family search, inbound replies by webhook.
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# The domain/address the demo inboxes hang off.
AGENTMAIL_EMAIL=

# Convex Auth (generated by `npx @convex-dev/auth`).
JWT_PRIVATE_KEY=
JWKS=
SITE_URL=

# ---------------------------------------------------------------------------
# Safety guard — CLAUDE.md section 7.1. We never email real facilities.
# Leave unset or "false". Outbound mail is routed to AgentMail inboxes we
# control unless this is explicitly turned on.
# ---------------------------------------------------------------------------
ALLOW_REAL_FACILITY_EMAIL=
