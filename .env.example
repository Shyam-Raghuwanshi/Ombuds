# Ombuds — environment variables.
# NAMES ONLY. Never commit real values.
#
# Almost everything here is set on the Convex deployment, not in a local file:
#   npx convex env set OPENAI_API_KEY <value>
#   npx convex env set OPENAI_API_KEY <value> --prod
#
# ---------------------------------------------------------------------------
# Local only — written to .env.local by `npx convex dev`. Do not set by hand.
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# ---------------------------------------------------------------------------
# AI. The product runs on OpenAI; convex/ai/provider.ts is the only file that
# names a model.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional. Override the small / large model ids (defaults: gpt-5-mini, gpt-5).
OPENAI_MODEL_SMALL=
OPENAI_MODEL_LARGE=
# Optional. Override the per-million-token prices used by the spend ledger
# (JSON keyed by "provider:model"; see convex/ai/provider.ts).
LLM_PRICES=

# ---------------------------------------------------------------------------
# Firecrawl — contact discovery, enrichment, local news, state licensing crawls.
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY=
# Optional. With it, crawls report progress by webhook; without it, they poll.
FIRECRAWL_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# AgentMail — one inbox per family search; replies arrive by webhook at
# https://<deployment>.convex.site/agentmail/webhook. The webhook must cover
# every inbox the app provisions, not just the org inbox below.
# ---------------------------------------------------------------------------
AGENTMAIL_API_KEY=
AGENTMAIL_WEBHOOK_SECRET=
# The org inbox. Used when AgentMail cannot issue a search its own inbox.
AGENTMAIL_EMAIL=

# ---------------------------------------------------------------------------
# Convex Auth (generate with `npx @convex-dev/auth`). CONVEX_SITE_URL is
# provided by Convex automatically.
# ---------------------------------------------------------------------------
JWT_PRIVATE_KEY=
JWKS=
SITE_URL=

# ---------------------------------------------------------------------------
# The send guard — CLAUDE.md section 7.1. We never email real facilities.
# A facility's own address can only be written to when BOTH of the first two
# are flipped from their defaults. See convex/lib/sendGuard.ts.
# ---------------------------------------------------------------------------
# Default true. Every inquiry is routed to an inbox we control and answered by
# a scripted persona.
OMBUDS_DEMO_MODE=true
# Default false. The second, independent switch required for live sends.
OMBUDS_ALLOW_REAL_SENDS=false
# Default true. In demo mode, still put the family's letters on the wire
# through AgentMail (to our own inbox). Set false to rehearse with no sends.
OMBUDS_DEMO_REAL_DELIVERY=true

# ---------------------------------------------------------------------------
# Timing overrides, in milliseconds. Leave unset in production.
# ---------------------------------------------------------------------------
# Silence before the one nudge. Default 72 hours.
OMBUDS_NUDGE_AFTER_MS=
# When an emailed answer is marked out of date. Default 30 days.
OMBUDS_STALE_AFTER_MS=
# Fixed delay before a demo persona replies. Default: a ladder from ~8 seconds.
OMBUDS_REPLY_DELAY_MS=
# Test seam. Forces every outbound send to fail so the recovery path can be
# exercised (the letter is recorded and the demo persona still replies).
# Never set in production.
OMBUDS_SIMULATE_SEND_FAILURE=
